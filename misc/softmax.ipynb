   "source": [
    "import numpy as np\n",
    "logits = np.array([[2.0, 1.0, 0.1],\n",
    "                   [1.0, 3.0, 0.2]])\n",
    "softmax = np.exp(logits) / np.sum(np.exp(logits), axis=1, keepdims=True)\n",
    "print(softmax)\n",
    "print(softmax.sum(axis=1))  # Each row sums to 1.0"
   ]
